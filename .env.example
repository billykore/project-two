# Copy to .env and fill in. .env is git-ignored; never commit real values.

DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Base64-encoded HMAC key, at least 32 bytes. Generate with: openssl rand -base64 32
APP_JWT_SECRET=

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Base64-encoded HMAC key for password-reset codes, at least 32 bytes. Generate with: openssl rand -base64 32
APP_RESET_CODE_SECRET=

# Development only: log password-reset codes so they can be read without an email or SMS provider.
# Leave false (or unset) in production.
APP_PASSWORD_RESET_LOG_CODES=true

# Development only: serve the OpenAPI document and Swagger UI (/swagger-ui.html). Leave false in production.
APP_API_DOCS_ENABLED=true
